# CareerTrack Environment Configuration Template

# Server Environment
ENVIRONMENT=development
PROJECT_NAME=CareerTrack

# Database Configuration (PostgreSQL in Docker, SQLite locally by default)
DATABASE_URL=sqlite:///./careertrack.db
# DATABASE_URL=postgresql://careertrack:your_secure_password@localhost:5432/careertrack_db

# JWT Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Application URL (Used in password reset links)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# ==============================================================================
# Email (SMTP) Configuration for Password Reset & Email Confirmation
# ==============================================================================
# When SMTP_HOST is left empty or unset in development, password reset links
# will be safely logged to the backend console/terminal for easy testing.
#
# Examples:
#
# --- Gmail SMTP Example ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=your_email@gmail.com
# EMAILS_FROM_NAME="CareerTrack"
#
# --- Mailtrap (Testing) Example ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_user
# SMTP_PASSWORD=your_mailtrap_password
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=noreply@careertrack.com
# EMAILS_FROM_NAME="CareerTrack"
#
# --- SendGrid Example ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=verified_sender@yourdomain.com
# EMAILS_FROM_NAME="CareerTrack"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@careertrack.com
EMAILS_FROM_NAME="CareerTrack"
