# CareerTrack Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual configuration

# Environment: development | production | test
ENVIRONMENT=development

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=careertrack
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD
POSTGRES_DB=careertrack_db
DATABASE_URL=postgresql://careertrack:YOUR_DATABASE_PASSWORD@localhost:5432/careertrack_db

# For zero-config local development with SQLite instead:
# DATABASE_URL=sqlite:///./careertrack.db

# Security & JWT Authentication (Generate secure 32+ character random strings)
# e.g., python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API URL (for production docker / client build)
VITE_API_URL=http://localhost:8000/api/v1
