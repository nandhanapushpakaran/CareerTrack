# CareerTrack Backend Environment Configuration Template

ENVIRONMENT=development
PROJECT_NAME=CareerTrack
DATABASE_URL=sqlite:///./careertrack.db
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost

# Email (SMTP) Configuration for Password Reset
# Leave SMTP_HOST empty for local development to print reset links to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@careertrack.com
EMAILS_FROM_NAME="CareerTrack"
